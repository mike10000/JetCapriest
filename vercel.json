{
  "version": 2,
  "name": "firstsundaymusic",
  "public": true,
  "rewrites": [
    { "source": "/first-sunday", "destination": "/first-sunday.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
