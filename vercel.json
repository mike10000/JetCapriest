{
  "version": 2,
  "name": "firstsundaymusic",
  "public": true,
  "redirects": [
    { "source": "/first-sunday", "destination": "/", "permanent": true },
    { "source": "/first-sunday.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
